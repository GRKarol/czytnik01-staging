{
  "name": "czytnik01",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Web flasher + PWA client app for the czytnik01 ESP32-S3 device",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"*.{html,ts,json,md}\"",
    "firmware:build": "python3 firmware/tools/export_web_firmware.py",
    "firmware:upload": "cd firmware && pio run -t upload",
    "firmware:monitor": "cd firmware && pio device monitor",
    "build:capacitor": "tsc --noEmit && vite build --config vite.capacitor.config.ts",
    "cap:sync": "npm run build:capacitor && npx cap sync android",
    "cap:open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "esp-web-tools": "^10.1.0",
    "jszip": "^3.10.1",
    "lit": "^3.2.0",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^22.19.19",
    "@types/w3c-web-serial": "^1.0.7",
    "@types/web-bluetooth": "^0.0.20",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.1.0"
  }
}
